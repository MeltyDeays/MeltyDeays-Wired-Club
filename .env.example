# Vercel & Sync Configuration Environment Variables
# Agrega estas variables en tu panel de Vercel (Project Settings -> Environment Variables)

# Claves de Groq (Llama 3.3) separadas por coma para rotación automática
GROQ_API_KEYS=gsk_xxx,gsk_yyy

# Token de Hugging Face para el modelo RMBG-1.4 (Remoción de fondo IA)
HF_TOKEN=hf_xxx

# ID del perfil de Facebook Marketplace (Opcional, default: 100071051942718)
FB_PROFILE_ID=100071051942718

# Firebase Firestore (Opcional si usa las configuradas por defecto)
FIRESTORE_PROJECT_ID=lain-wired-club
FIRESTORE_API_KEY=AIzaSyCzoNf4_dMiwcb_H9Ob_kQ-bvRCn97Pyig
