{
  "manifest_version": 3,
  "name": "Haibane Marketplace Sync // The Wired Club",
  "version": "1.0.0",
  "description": "Sincronización bidireccional en tiempo real entre Facebook Marketplace y el Catálogo Web Haibane.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://firestore.googleapis.com/*",
    "https://lain-wired-club.firebaseapp.com/*",
    "https://*.vercel.app/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Haibane Sync Engine"
  }
}
