{
  "manifest_version": 3,
  "name": "Haibane Marketplace Sync // The Wired Club",
  "version": "1.0.0",
  "description": "Sincronización bidireccional en tiempo real entre Facebook Marketplace y el Catálogo Web Haibane.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_fb_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://firebasestorage.googleapis.com/*",
    "https://lain-wired-club.firebaseapp.com/*",
    "https://*.vercel.app/*",
    "https://api.qrserver.com/*",
    "https://*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Haibane Sync Engine"
  }
}
